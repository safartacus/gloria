# Gloria - local environment
# Copy to .env (git-ignored), then: docker compose up -d --build
# docker compose reads .env automatically and substitutes ${VAR} in docker-compose.yml.

# --- Database ---
# SQLite — a single file inside the api container, persisted in the gloria-sqlite-data volume.
# No separate DB service / credentials. Nothing to configure here.

# --- Redis / RedisInsight ---
# host port -> container 6379
REDIS_PORT=6379
# cache browser at http://localhost:<this>
REDISINSIGHT_PORT=5540

# --- Seq (structured logs) ---
# Seq UI + log ingestion at http://localhost:<this>
SEQ_PORT=5341

# --- API ---
# direct API + Swagger at http://localhost:<this>/swagger
API_PORT=5080
ASPNETCORE_ENVIRONMENT=Development
# nightly job schedule + the "run date" day filter use this local timezone
TZ=Europe/Istanbul
# apply EF migrations (+ seed) on startup
GLORIA_AUTOMIGRATE=true
# JWT signing key - HS256, must be >= 32 chars. For a real deployment generate one: openssl rand -base64 48
JWT_SIGNING_KEY=dev-only-signing-key-change-me-please-32bytes-minimum-0123456789

# --- Web (SPA + /api proxy) ---
# app at http://localhost:<this>
WEB_PORT=8080

# --- Container registry (read by the GitHub Actions "publish" job) ---
# The workflow sources REGISTRY and IMAGE_PREFIX from this committed file.
# Images pushed:  ${REGISTRY}/${IMAGE_PREFIX}-api  and  ${REGISTRY}/${IMAGE_PREFIX}-web
# Auth is taken from GitHub repository secrets, NOT from here:
#   REGISTRY_USERNAME  optional, defaults to the GitHub actor
#   REGISTRY_TOKEN     optional, defaults to GITHUB_TOKEN (fine for ghcr.io)
REGISTRY=ghcr.io
IMAGE_PREFIX=safartacus/gloria
