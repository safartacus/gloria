{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": { "Application": "Gloria.Api" }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Gloria": "Data Source=gloria.db"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "gloria",
    "Audience": "gloria-web",
    "SigningKey": "dev-only-signing-key-change-me-please-32bytes-minimum-0123456789",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Gloria": {
    "AutoMigrate": true,
    "Credentials": {
      "Directory": ""
    },
    "SampleImport": {
      "Directory": "",
      "BusinessDay": "2026-08-31",
      "Pms": "pms_fidelio_2026_08.csv",
      "Pos": "pos_flyby_2026_08.csv",
      "Erp": "erp_jde_2026_08.csv"
    },
    "NightlyImport": {
      "Enabled": false,
      "RunAtLocalTime": "02:00",
      "InboxDirectory": "",
      "ArchiveDirectory": "",
      "PmsPattern": "pms_*.csv",
      "PosPattern": "pos_*.csv",
      "ErpPattern": "erp_*.csv"
    },
    "PersonnelSync": {
      "FilePath": ""
    }
  }
}
